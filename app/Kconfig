# Application-level Kconfig root.
# Sourcing Kconfig.zephyr pulls in the full Zephyr configuration tree,
# after which we layer the application-specific LED menu on top.

source "Kconfig.zephyr"

menuconfig LED_SUBSYSTEM
	bool "LED Subsystem"
	default y

if LED_SUBSYSTEM

choice LED_BLINK_SLEEP_TIME
	prompt "LED blink sleep time"
	default LED_BLINK_TIME_1S_MED

config LED_BLINK_TIME_05_FAST
	bool "0.5s (fast)"

config LED_BLINK_TIME_1S_MED
	bool "1s (medium)"

config LED_BLINK_TIME_2S_SLOW
	bool "2s (slow)"

endchoice

# Hidden companion of the choice above: the choice only selects *which*
# option is active, so this symbol maps that option to a value in ms.
# No prompt => it never shows up in menuconfig, it is just computed.
config LED_BLINK_SLEEP_TIME_MS
	int
	default 500 if LED_BLINK_TIME_05_FAST
	default 1000 if LED_BLINK_TIME_1S_MED
	default 2000 if LED_BLINK_TIME_2S_SLOW

menuconfig LED_ADVANCED_SETTINGS
	bool "Advanced LED settings"
	default n

if LED_ADVANCED_SETTINGS

config LED_BRIGHTNESS
	int "LED brightness (0-100)"
	default 100
	range 0 100

config LED_FADE_DURATION
	int "LED fade duration (ms)"
	default 500
	range 0 5000

menu "Expert settings"

config LED_DEBUG
	bool "Enable LED debugging"

config LED_CUSTOM_BLINK_PATTERN
	bool "Custom blink pattern"

endmenu # Expert settings

endif # LED_ADVANCED_SETTINGS

endif # LED_SUBSYSTEM

config APP_HEARTBEAT_PERIOD_MS
	int "Heartbeat LED blink period (ms)"
	default 500
	range 100 2000
	help
	Period of the application heartbeat LED, in milliseconds. The LED
	toggles once per period, so a 500 ms period gives a 1 Hz blink.
